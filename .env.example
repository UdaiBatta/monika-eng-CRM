DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
POSTGRES_DB=monika_erp
POSTGRES_USER=monika_erp
POSTGRES_PASSWORD=replace-for-non-local-use
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
DOCUMENT_STORAGE_BACKEND=apps.documents.storage.LocalPrivateStorageBackend
LOCAL_PRIVATE_STORAGE_ROOT=/app/private_storage
DOCUMENT_MAX_UPLOAD_SIZE_MB=50
# R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET_NAME=monika-erp-documents
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_REGION=auto
