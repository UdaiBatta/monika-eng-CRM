# Loaded only for the packaged Tauri desktop build (vite build --mode desktop).
# The plain browser production build does not read this file and keeps
# relative /api/v1 paths for its same-origin reverse proxy.
#
# Point this at the real hosted backend before distributing outside this
# network; for now it targets the same machine's Django dev server.
VITE_API_BASE_URL=http://127.0.0.1:8010
