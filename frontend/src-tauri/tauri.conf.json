{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Monika ERP",
  "version": "0.1.1",
  "identifier": "com.monikaengineers.erp",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Monika Engineers ERP",
        "url": "/app",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "python-runtime": "python-runtime/",
      "../../backend/apps": "backend/apps/",
      "../../backend/config": "backend/config/",
      "../../backend/manage.py": "backend/manage.py",
      "../../backend/desktop_server.py": "backend/desktop_server.py"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
